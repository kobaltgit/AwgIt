#!/bin/sh
# AwgIt Backend CGI API for OpenWrt
# Zero-daemon architecture: executed on-demand by uhttpd

# Output JSON header
printf "Content-Type: application/json; charset=utf-8\r\n"
printf "Cache-Control: no-cache, no-store, must-revalidate\r\n"
printf "Access-Control-Allow-Origin: *\r\n"
printf "Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n"
printf "Access-Control-Allow-Headers: Content-Type\r\n\r\n"

if [ "$REQUEST_METHOD" = "OPTIONS" ]; then
    exit 0
fi

WG_IF="awg0"
WG_BIN="/usr/bin/amneziawg"
[ -x "$WG_BIN" ] || WG_BIN="/usr/bin/awg"

# Helper: URL decode (pure POSIX / BusyBox ash compatible)
urldecode() {
    [ -z "$1" ] && return 0
    printf '%b' "$(printf '%s' "$1" | sed 's/+/ /g; s/%\([0-9a-fA-F][0-9a-fA-F]\)/\\x\1/g')" 2>/dev/null || printf '%s' "$1"
}

# Helper: validate WireGuard / AmneziaWG base64 key (44 chars ending in =)
is_valid_key() {
    [ -z "$1" ] && return 1
    case "$1" in
        *[!A-Za-z0-9+/=]*) return 1 ;;
    esac
    [ "${#1}" -eq 44 ] || return 1
    return 0
}

# Helper: sanitize client name (replaces spaces with underscores for WG interface compatibility; max 64 chars)
sanitize_name() {
    printf '%s' "$1" | tr ' ' '_' | sed 's/[^a-zA-Z0-9._-]//g' | cut -c 1-64
}

# Helper: sanitize text with UTF-8 / Cyrillic / emoji support (strips dangerous shell characters)
sanitize_text() {
    printf '%s' "$1" | tr -d '\r\n"\\;`$&|><' | tr -d "'" | cut -c 1-128
}

# Helper: sanitize admin password (preserves symbols like # $ & ! *; strips newlines and single quotes for UCI safety)
sanitize_password() {
    printf '%s' "$1" | tr -d "\r\n'" | cut -c 1-128
}

# Helper: validate IPv4 address with optional CIDR
is_valid_cidr() {
    _ip="$1"
    [ -z "$_ip" ] && return 1
    case "$_ip" in
        *[!0-9./]*) return 1 ;;
    esac
    _ip_part="${_ip%%/*}"
    _cidr_part="${_ip#*/}"
    [ "$_ip_part" = "$_cidr_part" ] && _cidr_part="32"

    _o1=$(printf '%s' "$_ip_part" | cut -d '.' -f 1)
    _o2=$(printf '%s' "$_ip_part" | cut -d '.' -f 2)
    _o3=$(printf '%s' "$_ip_part" | cut -d '.' -f 3)
    _o4=$(printf '%s' "$_ip_part" | cut -d '.' -f 4)

    [ -n "$_o1" ] && [ -n "$_o2" ] && [ -n "$_o3" ] && [ -n "$_o4" ] || return 1
    [ "$_o1" -ge 0 ] 2>/dev/null && [ "$_o1" -le 255 ] || return 1
    [ "$_o2" -ge 0 ] 2>/dev/null && [ "$_o2" -le 255 ] || return 1
    [ "$_o3" -ge 0 ] 2>/dev/null && [ "$_o3" -le 255 ] || return 1
    [ "$_o4" -ge 0 ] 2>/dev/null && [ "$_o4" -le 255 ] || return 1
    [ "$_cidr_part" -ge 0 ] 2>/dev/null && [ "$_cidr_part" -le 32 ] || return 1
    return 0
}

# Helper: parse query / body
QUERY="$QUERY_STRING"
RAW_BODY=""
if [ "$REQUEST_METHOD" = "POST" ]; then
    if [ -n "$CONTENT_LENGTH" ] && [ "$CONTENT_LENGTH" -gt 0 ] 2>/dev/null; then
        RAW_BODY=$(head -c "$CONTENT_LENGTH")
    else
        RAW_BODY=$(cat)
    fi
    if [ -n "$RAW_BODY" ]; then
        if printf '%s' "$RAW_BODY" | grep -q '^{' ; then
            QUERY=""
        else
            QUERY="$RAW_BODY"
        fi
    fi
fi

ACTION=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^action=' | head -n 1 | cut -d '=' -f 2)
ACTION=$(urldecode "$ACTION")

# Check if action was passed in URL for POST requests
if [ -z "$ACTION" ] && [ -n "$QUERY_STRING" ]; then
    ACTION=$(printf '%s' "$QUERY_STRING" | tr '&' '\n' | grep '^action=' | head -n 1 | cut -d '=' -f 2)
    ACTION=$(urldecode "$ACTION")
fi

[ -z "$ACTION" ] && ACTION="status"

# Fetch admin password from UCI
ADMIN_PASS=$(uci -q get network.awgit_settings.admin_password || true)

# Extract request password from query/body or HTTP header (cut -d '=' -f 2- preserves passwords containing '=')
REQ_PASS=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^password=' | head -n 1 | cut -d '=' -f 2-)
if [ -n "$REQ_PASS" ]; then
    REQ_PASS=$(urldecode "$REQ_PASS")
    REQ_PASS=$(sanitize_password "$REQ_PASS")
fi
if [ -z "$REQ_PASS" ] && [ -n "$HTTP_X_AWGIT_PASSWORD" ]; then
    REQ_PASS=$(sanitize_password "$HTTP_X_AWGIT_PASSWORD")
fi

# ==========================================================
# ACTION: AUTH CHECK
# ==========================================================
if [ "$ACTION" = "auth_check" ]; then
    if [ -n "$ADMIN_PASS" ]; then
        if [ "$REQ_PASS" = "$ADMIN_PASS" ]; then
            printf '{"status":"ok","authenticated":true,"auth_required":true}\n'
        else
            printf '{"status":"error","code":"unauthorized","authenticated":false,"auth_required":true,"message":"Invalid admin password"}\n'
        fi
    else
        printf '{"status":"ok","authenticated":true,"auth_required":false}\n'
    fi
    exit 0
fi

# ==========================================================
# AUTH GUARD: BLOCK UNAUTHORIZED REQUESTS
# ==========================================================
if [ -n "$ADMIN_PASS" ] && [ "$REQ_PASS" != "$ADMIN_PASS" ]; then
    printf '{"status":"error","code":"unauthorized","auth_required":true,"message":"Admin password required"}\n'
    exit 0
fi

# ==========================================================
# ACTION: SET / CHANGE ADMIN PASSWORD
# ==========================================================
if [ "$ACTION" = "set_password" ]; then
    RAW_OLD_PASS=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^old_password=' | head -n 1 | cut -d '=' -f 2-)
    OLD_PASS=$(urldecode "$RAW_OLD_PASS")
    [ -n "$OLD_PASS" ] && OLD_PASS=$(sanitize_password "$OLD_PASS")
    [ -z "$OLD_PASS" ] && OLD_PASS="$REQ_PASS"

    if [ -n "$ADMIN_PASS" ] && [ "$OLD_PASS" != "$ADMIN_PASS" ]; then
        printf '{"status":"error","message":"Invalid current password"}\n'
        exit 0
    fi

    RAW_NEW_PASS=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^new_password=' | head -n 1 | cut -d '=' -f 2-)
    NEW_PASS=$(urldecode "$RAW_NEW_PASS")
    [ -n "$NEW_PASS" ] && NEW_PASS=$(sanitize_password "$NEW_PASS")

    uci -q get network.awgit_settings >/dev/null 2>&1 || uci set network.awgit_settings=awgit
    if [ -n "$NEW_PASS" ]; then
        uci set network.awgit_settings.admin_password="$NEW_PASS"
    else
        uci -q delete network.awgit_settings.admin_password || true
    fi
    uci commit network
    printf '{"status":"ok","message":"Password updated"}\n'
    exit 0
fi

# ==========================================================
# ACTION: SAVE CATEGORIES
# ==========================================================
if [ "$ACTION" = "save_categories" ]; then
    RAW_CATS=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^categories=' | head -n 1 | cut -d '=' -f 2)
    CATS=$(urldecode "$RAW_CATS")
    case "$CATS" in
        \[*\]) ;;
        *) CATS="[]" ;;
    esac
    SAFE_CATS=$(printf '%s' "$CATS" | tr -d '\r\n\\;`$&|><' | tr -d "'")

    uci -q get network.awgit_settings >/dev/null 2>&1 || uci set network.awgit_settings=awgit
    uci set network.awgit_settings.categories="$SAFE_CATS"
    uci commit network
    printf '{"status":"ok","message":"Categories saved"}\n'
    exit 0
fi

# Fetch server params from UCI
SERVER_PORT=$(uci -q get network.${WG_IF}.listen_port || echo "49155")
SERVER_PRIV=$(uci -q get network.${WG_IF}.private_key)
SERVER_PUB=""
if [ -n "$SERVER_PRIV" ] && [ -x "$WG_BIN" ]; then
    SERVER_PUB=$(printf '%s' "$SERVER_PRIV" | $WG_BIN pubkey 2>/dev/null)
fi

JC=$(uci -q get network.${WG_IF}.awg_jc || echo "4")
JMIN=$(uci -q get network.${WG_IF}.awg_jmin || echo "40")
JMAX=$(uci -q get network.${WG_IF}.awg_jmax || echo "70")
S1=$(uci -q get network.${WG_IF}.awg_s1 || echo "15")
S2=$(uci -q get network.${WG_IF}.awg_s2 || echo "32")
H1=$(uci -q get network.${WG_IF}.awg_h1 || echo "1")
H2=$(uci -q get network.${WG_IF}.awg_h2 || echo "2")
H3=$(uci -q get network.${WG_IF}.awg_h3 || echo "3")
H4=$(uci -q get network.${WG_IF}.awg_h4 || echo "4")

EXT_IP=$(uci -q get network.${WG_IF}.endpoint_host)
[ -z "$EXT_IP" ] && EXT_IP="62.16.41.168"

NOW=$(date +%s)

# Helper: Build client conf string
generate_conf() {
    _client_ip="$1"
    _client_priv="$2"
    printf "[Interface]\nAddress = %s\nPrivateKey = %s\nDNS = 10.9.0.1, 77.88.8.8\nJc = %s\nJmin = %s\nJmax = %s\nS1 = %s\nS2 = %s\nH1 = %s\nH2 = %s\nH3 = %s\nH4 = %s\n\n[Peer]\nPublicKey = %s\nEndpoint = %s:%s\nAllowedIPs = 0.0.0.0/0\nPersistentKeepalive = 25\n" \
        "$_client_ip" "$_client_priv" "$JC" "$JMIN" "$JMAX" "$S1" "$S2" "$H1" "$H2" "$H3" "$H4" "$SERVER_PUB" "$EXT_IP" "$SERVER_PORT"
}

# ==========================================================
# ACTION: STATUS / LIST
# ==========================================================
if [ "$ACTION" = "status" ] || [ "$ACTION" = "list" ]; then
    TMP_DUMP="/tmp/awg_dump_$$"
    $WG_BIN show "$WG_IF" dump 2>/dev/null > "$TMP_DUMP" || true

    printf '{\n'
    printf '  "status": "ok",\n'
    printf '  "server": {\n'
    printf '    "interface": "%s",\n' "$WG_IF"
    printf '    "public_key": "%s",\n' "$SERVER_PUB"
    printf '    "listen_port": %s,\n' "$SERVER_PORT"
    printf '    "endpoint": "%s:%s",\n' "$EXT_IP" "$SERVER_PORT"
    printf '    "awg_params": {\n'
    printf '      "jc": %s, "jmin": %s, "jmax": %s,\n' "$JC" "$JMIN" "$JMAX"
    printf '      "s1": %s, "s2": %s,\n' "$S1" "$S2"
    printf '      "h1": %s, "h2": %s, "h3": %s, "h4": %s\n' "$H1" "$H2" "$H3" "$H4"
    printf '    }\n'
    printf '  },\n'

    AUTH_REQ="false"
    [ -n "$ADMIN_PASS" ] && AUTH_REQ="true"
    CATS_RAW=$(uci -q get network.awgit_settings.categories)
    case "$CATS_RAW" in
        \[*\]) ;;
        *) CATS_RAW="[]" ;;
    esac

    printf '  "auth_required": %s,\n' "$AUTH_REQ"
    printf '  "categories": %s,\n' "$CATS_RAW"
    printf '  "peers": [\n'

    FIRST_PEER=1
    SECTIONS=$(uci show network | grep '=amneziawg_awg0' | cut -d '.' -f 2 | cut -d '=' -f 1)

    for SEC in $SECTIONS; do
        NAME=$(uci -q get network.${SEC}.description)
        [ -z "$NAME" ] && NAME="Client-${SEC}"
        PUB=$(uci -q get network.${SEC}.public_key)
        PRIV=$(uci -q get network.${SEC}.private_key)
        ALLOWED_IP=$(uci -q get network.${SEC}.allowed_ips)
        DISABLED=$(uci -q get network.${SEC}.disabled || echo "0")
        GROUP=$(uci -q get network.${SEC}.group)
        NOTES=$(uci -q get network.${SEC}.notes)
        CREATED=$(uci -q get network.${SEC}.created_at || echo "0")
        [ -z "$CREATED" ] && CREATED="0"

        HAS_CONF="false"
        [ -n "$PRIV" ] && HAS_CONF="true"

        RX="0"
        TX="0"
        LATEST="0"
        ENDPOINT=""

        if [ -f "$TMP_DUMP" ] && [ -n "$PUB" ]; then
            DUMP_LINE=$(grep "^${PUB}" "$TMP_DUMP" | head -n 1)
            if [ -n "$DUMP_LINE" ]; then
                ENDPOINT=$(printf '%s' "$DUMP_LINE" | awk '{print $3}')
                LATEST=$(printf '%s' "$DUMP_LINE" | awk '{print $5}')
                RX=$(printf '%s' "$DUMP_LINE" | awk '{print $6}')
                TX=$(printf '%s' "$DUMP_LINE" | awk '{print $7}')
            fi
        fi

        [ -z "$RX" ] && RX="0"
        [ -z "$TX" ] && TX="0"
        [ -z "$LATEST" ] && LATEST="0"

        ONLINE="false"
        if [ "$LATEST" -gt 0 ] && [ $((NOW - LATEST)) -lt 180 ]; then
            ONLINE="true"
        fi

        if [ "$FIRST_PEER" -eq 0 ]; then
            printf ',\n'
        fi
        FIRST_PEER=0

        printf '    {\n'
        printf '      "section": "%s",\n' "$SEC"
        printf '      "name": "%s",\n' "$NAME"
        printf '      "public_key": "%s",\n' "$PUB"
        printf '      "allowed_ips": "%s",\n' "$ALLOWED_IP"
        printf '      "has_config": %s,\n' "$HAS_CONF"
        printf '      "disabled": %s,\n' "$DISABLED"
        printf '      "online": %s,\n' "$ONLINE"
        printf '      "latest_handshake": %s,\n' "$LATEST"
        printf '      "transfer_rx": %s,\n' "$RX"
        printf '      "transfer_tx": %s,\n' "$TX"
        printf '      "endpoint": "%s",\n' "$ENDPOINT"
        printf '      "group": "%s",\n' "$GROUP"
        printf '      "notes": "%s",\n' "$NOTES"
        printf '      "created_at": %s\n' "$CREATED"
        printf '    }'
    done

    rm -f "$TMP_DUMP"
    printf '\n  ]\n}\n'
    exit 0
fi

# ==========================================================
# ACTION: CLIENT CONFIG (FOR QR & DOWNLOAD)
# ==========================================================
if [ "$ACTION" = "client_config" ]; then
    TARGET_PUB=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^public_key=' | head -n 1 | cut -d '=' -f 2)
    TARGET_PUB=$(urldecode "$TARGET_PUB")

    if ! is_valid_key "$TARGET_PUB"; then
        printf '{"status":"error","message":"Invalid public_key format"}\n'
        exit 0
    fi

    SECTIONS=$(uci show network | grep '=amneziawg_awg0' | cut -d '.' -f 2 | cut -d '=' -f 1)
    for SEC in $SECTIONS; do
        PUB=$(uci -q get network.${SEC}.public_key)
        if [ "$PUB" = "$TARGET_PUB" ]; then
            NAME=$(uci -q get network.${SEC}.description || echo "client")
            PRIV=$(uci -q get network.${SEC}.private_key)
            ALLOWED_IP=$(uci -q get network.${SEC}.allowed_ips | cut -d '/' -f 1)
            [ -z "$ALLOWED_IP" ] && ALLOWED_IP="10.9.0.2"

            if [ -z "$PRIV" ]; then
                printf '{"status":"error","message":"Private key not stored for this peer"}\n'
                exit 0
            fi

            CONF=$(generate_conf "${ALLOWED_IP}/24" "$PRIV")
            CONF_JSON=$(printf '%s' "$CONF" | sed ':a;N;$!ba;s/\n/\\n/g' | sed 's/"/\\"/g')

            printf '{\n'
            printf '  "status": "ok",\n'
            printf '  "name": "%s",\n' "$NAME"
            printf '  "config": "%s"\n' "$CONF_JSON"
            printf '}\n'
            exit 0
        fi
    done

    printf '{"status":"error","message":"Peer not found"}\n'
    exit 0
fi

# ==========================================================
# ACTION: REGENERATE KEYS FOR PEER
# ==========================================================
if [ "$ACTION" = "regen_keys" ]; then
    TARGET_PUB=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^public_key=' | head -n 1 | cut -d '=' -f 2)
    TARGET_PUB=$(urldecode "$TARGET_PUB")
    if ! is_valid_key "$TARGET_PUB"; then
        printf '{"status":"error","message":"Invalid or missing public_key"}\n'
        exit 0
    fi

    SECTIONS=$(uci show network | grep '=amneziawg_awg0' | cut -d '.' -f 2 | cut -d '=' -f 1)
    FOUND=0
    for SEC in $SECTIONS; do
        PUB=$(uci -q get network.${SEC}.public_key)
        if [ "$PUB" = "$TARGET_PUB" ]; then
            FOUND=1
            NAME=$(uci -q get network.${SEC}.description || echo "client")
            ALLOWED_IP=$(uci -q get network.${SEC}.allowed_ips)
            DISABLED=$(uci -q get network.${SEC}.disabled || echo "0")

            NEW_PRIV=$($WG_BIN genkey)
            NEW_PUB=$(printf '%s' "$NEW_PRIV" | $WG_BIN pubkey)

            uci set network.${SEC}.public_key="$NEW_PUB"
            uci set network.${SEC}.private_key="$NEW_PRIV"
            uci commit network

            $WG_BIN set "$WG_IF" peer "$TARGET_PUB" remove 2>/dev/null || true
            if [ "$DISABLED" != "1" ]; then
                $WG_BIN set "$WG_IF" peer "$NEW_PUB" allowed-ips "$ALLOWED_IP" persistent-keepalive 25 2>/dev/null || true
            fi

            CLIENT_IP_NO_CIDR=$(printf '%s' "$ALLOWED_IP" | cut -d '/' -f 1)
            CONF=$(generate_conf "${CLIENT_IP_NO_CIDR}/24" "$NEW_PRIV")
            CONF_JSON=$(printf '%s' "$CONF" | sed ':a;N;$!ba;s/\n/\\n/g' | sed 's/"/\\"/g')

            printf '{\n'
            printf '  "status": "ok",\n'
            printf '  "name": "%s",\n' "$NAME"
            printf '  "public_key": "%s",\n' "$NEW_PUB"
            printf '  "config": "%s"\n' "$CONF_JSON"
            printf '}\n'
            exit 0
        fi
    done

    printf '{"status":"error","message":"Peer not found"}\n'
    exit 0
fi


# ==========================================================
# ACTION: CREATE PEER
# ==========================================================
if [ "$ACTION" = "create" ]; then
    RAW_NAME=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^name=' | head -n 1 | cut -d '=' -f 2)
    NAME=$(urldecode "$RAW_NAME")
    NAME=$(sanitize_name "$NAME")
    [ -z "$NAME" ] && NAME="Client-$NOW"

    RAW_GROUP=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^group=' | head -n 1 | cut -d '=' -f 2)
    GROUP=$(urldecode "$RAW_GROUP")
    GROUP=$(sanitize_text "$GROUP")

    RAW_NOTES=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^notes=' | head -n 1 | cut -d '=' -f 2)
    NOTES=$(urldecode "$RAW_NOTES")
    NOTES=$(sanitize_text "$NOTES")

    PRIV_KEY=$($WG_BIN genkey)
    PUB_KEY=$(printf '%s' "$PRIV_KEY" | $WG_BIN pubkey)

    MAX_IP=1
    ASSIGNED_IPS=$(uci show network | grep '\.allowed_ips=' | grep '10\.9\.0\.' | awk -F "['/]" '{print $2}' | cut -d '.' -f 4)
    for IP_NUM in $ASSIGNED_IPS; do
        if [ "$IP_NUM" -gt "$MAX_IP" ] 2>/dev/null; then
            MAX_IP=$IP_NUM
        fi
    done
    NEXT_IP=$((MAX_IP + 1))
    if [ "$NEXT_IP" -gt 254 ]; then
        printf '{"status":"error","message":"IP pool 10.9.0.0/24 exhausted"}\n'
        exit 0
    fi
    CLIENT_IP="10.9.0.${NEXT_IP}"

    SEC_NAME=$(uci add network amneziawg_awg0)
    uci set network.${SEC_NAME}.description="$NAME"
    uci set network.${SEC_NAME}.public_key="$PUB_KEY"
    uci set network.${SEC_NAME}.private_key="$PRIV_KEY"
    uci set network.${SEC_NAME}.allowed_ips="${CLIENT_IP}/32"
    uci set network.${SEC_NAME}.persistent_keepalive="25"
    [ -n "$GROUP" ] && uci set network.${SEC_NAME}.group="$GROUP"
    [ -n "$NOTES" ] && uci set network.${SEC_NAME}.notes="$NOTES"
    uci set network.${SEC_NAME}.created_at="$NOW"
    uci commit network

    $WG_BIN set "$WG_IF" peer "$PUB_KEY" allowed-ips "${CLIENT_IP}/32" persistent-keepalive 25

    CONF=$(generate_conf "${CLIENT_IP}/24" "$PRIV_KEY")
    CONF_JSON=$(printf '%s' "$CONF" | sed ':a;N;$!ba;s/\n/\\n/g' | sed 's/"/\\"/g')

    printf '{\n'
    printf '  "status": "ok",\n'
    printf '  "message": "Peer created successfully",\n'
    printf '  "peer": {\n'
    printf '    "section": "%s",\n' "$SEC_NAME"
    printf '    "name": "%s",\n' "$NAME"
    printf '    "public_key": "%s",\n' "$PUB_KEY"
    printf '    "allowed_ips": "%s/32",\n' "$CLIENT_IP"
    printf '    "group": "%s",\n' "$GROUP"
    printf '    "notes": "%s",\n' "$NOTES"
    printf '    "created_at": %s,\n' "$NOW"
    printf '    "config": "%s"\n' "$CONF_JSON"
    printf '  }\n'
    printf '}\n'
    exit 0
fi

# ==========================================================
# ACTION: DELETE PEER
# ==========================================================
if [ "$ACTION" = "delete" ]; then
    TARGET_PUB=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^public_key=' | head -n 1 | cut -d '=' -f 2)
    TARGET_PUB=$(urldecode "$TARGET_PUB")

    if ! is_valid_key "$TARGET_PUB"; then
        printf '{"status":"error","message":"Invalid or missing public_key"}\n'
        exit 0
    fi

    SECTIONS=$(uci show network | grep '=amneziawg_awg0' | cut -d '.' -f 2 | cut -d '=' -f 1)
    FOUND=0
    for SEC in $SECTIONS; do
        PUB=$(uci -q get network.${SEC}.public_key)
        if [ "$PUB" = "$TARGET_PUB" ]; then
            uci delete network.${SEC}
            FOUND=1
        fi
    done

    if [ "$FOUND" -eq 1 ]; then
        uci commit network
        $WG_BIN set "$WG_IF" peer "$TARGET_PUB" remove 2>/dev/null || true
        printf '{"status":"ok","message":"Peer removed"}\n'
    else
        printf '{"status":"error","message":"Peer not found in config"}\n'
    fi
    exit 0
fi

# ==========================================================
# ACTION: TOGGLE PEER
# ==========================================================
if [ "$ACTION" = "toggle" ]; then
    TARGET_PUB=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^public_key=' | head -n 1 | cut -d '=' -f 2)
    TARGET_PUB=$(urldecode "$TARGET_PUB")
    STATE=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^disabled=' | head -n 1 | cut -d '=' -f 2)
    [ "$STATE" = "1" ] || STATE="0"

    if ! is_valid_key "$TARGET_PUB"; then
        printf '{"status":"error","message":"Invalid or missing public_key"}\n'
        exit 0
    fi

    SECTIONS=$(uci show network | grep '=amneziawg_awg0' | cut -d '.' -f 2 | cut -d '=' -f 1)
    for SEC in $SECTIONS; do
        PUB=$(uci -q get network.${SEC}.public_key)
        if [ "$PUB" = "$TARGET_PUB" ]; then
            ALLOWED_IP=$(uci -q get network.${SEC}.allowed_ips)
            uci set network.${SEC}.disabled="$STATE"
            uci commit network

            if [ "$STATE" = "1" ]; then
                $WG_BIN set "$WG_IF" peer "$TARGET_PUB" remove 2>/dev/null || true
            else
                $WG_BIN set "$WG_IF" peer "$TARGET_PUB" allowed-ips "$ALLOWED_IP" persistent-keepalive 25 2>/dev/null || true
            fi
            printf '{"status":"ok","message":"Peer state updated"}\n'
            exit 0
        fi
    done

    printf '{"status":"error","message":"Peer not found"}\n'
    exit 0
fi

# ==========================================================
# ACTION: UPDATE PEER (NAME, ALLOWED IPS, GROUP, NOTES)
# ==========================================================
if [ "$ACTION" = "update" ] || [ "$ACTION" = "update_peer" ]; then
    TARGET_PUB=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^public_key=' | head -n 1 | cut -d '=' -f 2)
    TARGET_PUB=$(urldecode "$TARGET_PUB")
    RAW_NAME=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^name=' | head -n 1 | cut -d '=' -f 2)
    NEW_NAME=$(urldecode "$RAW_NAME")
    NEW_NAME=$(sanitize_name "$NEW_NAME")

    RAW_GROUP=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^group=' | head -n 1 | cut -d '=' -f 2)
    NEW_GROUP=$(urldecode "$RAW_GROUP")
    NEW_GROUP=$(sanitize_text "$NEW_GROUP")

    RAW_NOTES=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^notes=' | head -n 1 | cut -d '=' -f 2)
    NEW_NOTES=$(urldecode "$RAW_NOTES")
    NEW_NOTES=$(sanitize_text "$NEW_NOTES")

    RAW_IP=$(printf '%s' "$QUERY" | tr '&' '\n' | grep '^allowed_ips=' | head -n 1 | cut -d '=' -f 2)
    NEW_IP=$(urldecode "$RAW_IP")

    if ! is_valid_key "$TARGET_PUB"; then
        printf '{"status":"error","message":"Invalid or missing public_key"}\n'
        exit 0
    fi

    if [ -n "$NEW_IP" ] && ! is_valid_cidr "$NEW_IP"; then
        printf '{"status":"error","message":"Invalid allowed_ips format"}\n'
        exit 0
    fi

    SECTIONS=$(uci show network | grep '=amneziawg_awg0' | cut -d '.' -f 2 | cut -d '=' -f 1)
    FOUND=0
    for SEC in $SECTIONS; do
        PUB=$(uci -q get network.${SEC}.public_key)
        if [ "$PUB" = "$TARGET_PUB" ]; then
            FOUND=1
            [ -n "$NEW_NAME" ] && uci set network.${SEC}.description="$NEW_NAME"
            if printf '%s' "$QUERY" | grep -q 'group='; then
                if [ -n "$NEW_GROUP" ]; then
                    uci set network.${SEC}.group="$NEW_GROUP"
                else
                    uci -q delete network.${SEC}.group || true
                fi
            fi
            if printf '%s' "$QUERY" | grep -q 'notes='; then
                if [ -n "$NEW_NOTES" ]; then
                    uci set network.${SEC}.notes="$NEW_NOTES"
                else
                    uci -q delete network.${SEC}.notes || true
                fi
            fi
            if [ -n "$NEW_IP" ]; then
                case "$NEW_IP" in
                    */*) ;;
                    *) NEW_IP="${NEW_IP}/32" ;;
                esac
                uci set network.${SEC}.allowed_ips="$NEW_IP"
                DISABLED=$(uci -q get network.${SEC}.disabled || echo "0")
                if [ "$DISABLED" != "1" ]; then
                    $WG_BIN set "$WG_IF" peer "$TARGET_PUB" allowed-ips "$NEW_IP" 2>/dev/null || true
                fi
            fi
            uci commit network
            printf '{"status":"ok","message":"Peer updated"}\n'
            exit 0
        fi
    done

    printf '{"status":"error","message":"Peer not found"}\n'
    exit 0
fi


# ==========================================================
# ACTION: BACKUP
# ==========================================================
if [ "$ACTION" = "backup" ]; then
    CATS_RAW=$(uci -q get network.awgit_settings.categories)
    case "$CATS_RAW" in
        \[*\]) ;;
        *) CATS_RAW="[]" ;;
    esac

    printf '{\n'
    printf '  "version": 2,\n'
    printf '  "created_at": %s,\n' "$NOW"
    printf '  "categories": %s,\n' "$CATS_RAW"
    printf '  "server": {\n'
    printf '    "endpoint": "%s:%s",\n' "$EXT_IP" "$SERVER_PORT"
    printf '    "public_key": "%s",\n' "$SERVER_PUB"
    printf '    "listen_port": %s\n' "$SERVER_PORT"
    printf '  },\n'
    printf '  "peers": [\n'

    FIRST_PEER=1
    SECTIONS=$(uci show network | grep '=amneziawg_awg0' | cut -d '.' -f 2 | cut -d '=' -f 1)
    for SEC in $SECTIONS; do
        NAME=$(uci -q get network.${SEC}.description)
        PUB=$(uci -q get network.${SEC}.public_key)
        PRIV=$(uci -q get network.${SEC}.private_key)
        ALLOWED_IP=$(uci -q get network.${SEC}.allowed_ips)
        DISABLED=$(uci -q get network.${SEC}.disabled || echo "0")
        GROUP=$(uci -q get network.${SEC}.group)
        NOTES=$(uci -q get network.${SEC}.notes)
        CREATED=$(uci -q get network.${SEC}.created_at || echo "0")
        [ -z "$CREATED" ] && CREATED="0"

        if [ "$FIRST_PEER" -eq 0 ]; then
            printf ',\n'
        fi
        FIRST_PEER=0

        printf '    {\n'
        printf '      "name": "%s",\n' "$NAME"
        printf '      "public_key": "%s",\n' "$PUB"
        printf '      "private_key": "%s",\n' "$PRIV"
        printf '      "allowed_ips": "%s",\n' "$ALLOWED_IP"
        printf '      "disabled": %s,\n' "$DISABLED"
        printf '      "group": "%s",\n' "$GROUP"
        printf '      "notes": "%s",\n' "$NOTES"
        printf '      "created_at": %s\n' "$CREATED"
        printf '    }'
    done

    printf '\n  ]\n}\n'
    exit 0
fi

# ==========================================================
# ACTION: RESTORE
# ==========================================================
if [ "$ACTION" = "restore" ]; then
    if [ -z "$RAW_BODY" ]; then
        printf '{"status":"error","message":"Empty backup data"}\n'
        exit 0
    fi

    TMP_IN="/tmp/awg_restore_$$.json"
    printf '%s' "$RAW_BODY" > "$TMP_IN"

    R_CATS=$(jsonfilter -i "$TMP_IN" -e "@.categories" 2>/dev/null || true)
    if [ -n "$R_CATS" ] && [ "$R_CATS" != "null" ]; then
        SAFE_CATS=$(printf '%s' "$R_CATS" | tr -d '\r\n\\;`$&|><' | tr -d "'")
        uci -q get network.awgit_settings >/dev/null 2>&1 || uci set network.awgit_settings=awgit
        uci set network.awgit_settings.categories="$SAFE_CATS"
        uci commit network
    fi

    RESTORED=0
    idx=0
    while true; do
        R_PUB=$(jsonfilter -i "$TMP_IN" -e "@.peers[$idx].public_key" 2>/dev/null)
        [ -z "$R_PUB" ] && break
        R_NAME=$(jsonfilter -i "$TMP_IN" -e "@.peers[$idx].name" 2>/dev/null)
        R_PRIV=$(jsonfilter -i "$TMP_IN" -e "@.peers[$idx].private_key" 2>/dev/null)
        R_IP=$(jsonfilter -i "$TMP_IN" -e "@.peers[$idx].allowed_ips" 2>/dev/null)
        R_DIS=$(jsonfilter -i "$TMP_IN" -e "@.peers[$idx].disabled" 2>/dev/null)
        R_GROUP=$(jsonfilter -i "$TMP_IN" -e "@.peers[$idx].group" 2>/dev/null || true)
        R_NOTES=$(jsonfilter -i "$TMP_IN" -e "@.peers[$idx].notes" 2>/dev/null || true)
        R_CREATED=$(jsonfilter -i "$TMP_IN" -e "@.peers[$idx].created_at" 2>/dev/null || true)

        [ -z "$R_NAME" ] && R_NAME="Client-$idx"
        R_NAME=$(sanitize_name "$R_NAME")
        [ -z "$R_DIS" ] && R_DIS="0"
        [ "$R_DIS" = "1" ] || R_DIS="0"

        if [ -n "$R_PUB" ] && [ -n "$R_IP" ] && is_valid_key "$R_PUB" && is_valid_cidr "$R_IP"; then
            if [ -n "$R_PRIV" ] && ! is_valid_key "$R_PRIV"; then
                R_PRIV=""
            fi
            # Check if peer already exists by public_key
            EXISTS=$(uci show network | grep -F "public_key='${R_PUB}'" || true)
            if [ -z "$EXISTS" ]; then
                SEC=$(uci add network amneziawg_awg0)
                uci set network.${SEC}.description="$R_NAME"
                uci set network.${SEC}.public_key="$R_PUB"
                [ -n "$R_PRIV" ] && uci set network.${SEC}.private_key="$R_PRIV"
                uci set network.${SEC}.allowed_ips="$R_IP"
                uci set network.${SEC}.persistent_keepalive="25"
                uci set network.${SEC}.disabled="$R_DIS"
                [ -n "$R_GROUP" ] && [ "$R_GROUP" != "null" ] && uci set network.${SEC}.group="$R_GROUP"
                [ -n "$R_NOTES" ] && [ "$R_NOTES" != "null" ] && uci set network.${SEC}.notes="$R_NOTES"
                [ -n "$R_CREATED" ] && [ "$R_CREATED" != "null" ] && uci set network.${SEC}.created_at="$R_CREATED"
                uci commit network

                if [ "$R_DIS" != "1" ]; then
                    $WG_BIN set "$WG_IF" peer "$R_PUB" allowed-ips "$R_IP" persistent-keepalive 25 2>/dev/null || true
                fi
                RESTORED=$((RESTORED + 1))
            fi
        fi
        idx=$((idx + 1))
    done

    rm -f "$TMP_IN"
    printf '{"status":"ok","message":"Restore processed","restored":%s}\n' "$RESTORED"
    exit 0
fi

printf '{"status":"error","message":"Unknown action"}\n'
exit 0
